        {"expr": "witw:spark_source_lag{app=\"news-unclassified-issue-stream-v1\",topic=~\"$topic\"}", "legendFormat": "미분류 이슈 처리 / {{topic}} / 파티션 {{partition}}", "refId": "B"}
      ],
