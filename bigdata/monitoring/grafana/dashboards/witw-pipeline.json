    {"id":20,"type":"timeseries","title":"EC2 CPU 사용률","datasource":{"type":"prometheus","uid":"prometheus-bigdata"},"gridPos":{"h":8,"w":12,"x":0,"y":52},"fieldConfig":{"defaults":{"unit":"percent","min":0},"overrides":[]},"targets":[{"refId":"A","expr":"100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[5m])))","legendFormat":"{{instance}}"}]},
    {"id":21,"type":"timeseries","title":"EC2 메모리 사용률","datasource":{"type":"prometheus","uid":"prometheus-bigdata"},"gridPos":{"h":8,"w":12,"x":12,"y":52},"fieldConfig":{"defaults":{"unit":"percent","min":0},"overrides":[]},"targets":[{"refId":"A","expr":"100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})","legendFormat":"{{instance}}"}]},
    {"id":22,"type":"timeseries","title":"EC2 디스크 사용률","datasource":{"type":"prometheus","uid":"prometheus-bigdata"},"gridPos":{"h":8,"w":12,"x":0,"y":60},"fieldConfig":{"defaults":{"unit":"percent","min":0},"overrides":[]},"targets":[{"refId":"A","expr":"100 * (1 - node_filesystem_avail_bytes{job=\"node\",fstype!~\"tmpfs|overlay|squashfs\",device!~\"rootfs\",mountpoint!~\"/run.*|/var/lib/docker/.+\"} / node_filesystem_size_bytes{job=\"node\",fstype!~\"tmpfs|overlay|squashfs\",device!~\"rootfs\",mountpoint!~\"/run.*|/var/lib/docker/.+\"})","legendFormat":"{{mountpoint}}"}]},
    {"id":23,"type":"timeseries","title":"EC2 디스크 읽기·쓰기","datasource":{"type":"prometheus","uid":"prometheus-bigdata"},"gridPos":{"h":8,"w":12,"x":12,"y":60},"fieldConfig":{"defaults":{"unit":"Bps","min":0},"overrides":[]},"targets":[{"refId":"A","expr":"rate(node_disk_read_bytes_total{job=\"node\",device!~\"loop.*|ram.*\"}[5m])","legendFormat":"{{device}} 읽기"},{"refId":"B","expr":"rate(node_disk_written_bytes_total{job=\"node\",device!~\"loop.*|ram.*\"}[5m])","legendFormat":"{{device}} 쓰기"}]},
