  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "정상 수집 대상 수",
      "description": "Prometheus가 정상적으로 수집 중인 Kafka, HDFS, Spark 대상의 수입니다. 전체 9개가 정상이면 초록색으로 표시됩니다.",
      "id": 1,
      "datasource": {"type": "prometheus", "uid": "prometheus-bigdata"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(up{job=~\"kafka-offsets|kafka-broker|hdfs|spark-master|spark-worker|spark-driver|spark-streaming\"})", "refId": "A"}],
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 9}]}}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "전체 미처리 메시지 수",
      "description": "선택한 Kafka 컨슈머 그룹이 아직 처리하지 못하고 밀려 있는 메시지의 총합입니다.",
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "prometheus-bigdata"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "sum(kafka_consumergroup_lag{consumergroup=~\"$group\"})", "refId": "A"}],
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}, {"color": "red", "value": 1000}]}}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "NLP 워커 처리 속도 (Kafka 커밋 기준)",
      "description": "NLP 워커가 news.raw.v1에서 읽고 처리를 끝내 Kafka에 커밋한 초당 메시지 수입니다. 유효하지 않아 폐기된 메시지도 커밋되므로 이 값에 포함됩니다.",
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "prometheus-bigdata"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "witw:kafka_nlp_committed_records_per_second", "legendFormat": "초당 처리 완료 건수", "refId": "A"}],
      "options": {"colorMode": "none", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "fieldConfig": {"defaults": {"unit": "suffix: 건/초"}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "HDFS 저장 공간 사용률",
      "description": "HDFS 전체 저장 공간 중 현재 사용 중인 비율입니다.",
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "prometheus-bigdata"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "100 * hdfs_capacity_used_bytes / hdfs_capacity_total_bytes", "refId": "A"}],
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 80}]}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "토픽별 Kafka 보관 메시지 수",
      "description": "각 Kafka 토픽에 현재 남아 있는 메시지 수입니다. 가장 오래된 오프셋부터 최신 오프셋까지의 차이로 계산합니다.",
      "id": 5,
      "datasource": {"type": "prometheus", "uid": "prometheus-bigdata"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{"expr": "sum by (topic) (kafka_topic_partition_current_offset{topic=~\"$topic\"} - kafka_topic_partition_oldest_offset{topic=~\"$topic\"})", "legendFormat": "{{topic}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "토픽별 Kafka 유입 속도",
      "description": "각 Kafka 토픽에 새 메시지가 들어오는 속도입니다. 최근 5분을 기준으로 초당 건수를 계산합니다.",
      "id": 6,
      "datasource": {"type": "prometheus", "uid": "prometheus-bigdata"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{topic=~\"$topic\"}[5m]))", "legendFormat": "{{topic}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "suffix: 건/초", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "컨슈머 그룹·토픽별 미처리 메시지 수",
      "description": "각 컨슈머 그룹이 토픽에서 아직 처리하지 못한 메시지 수입니다. 값이 계속 증가하면 처리 속도가 유입 속도를 따라가지 못하는 상태입니다.",
      "id": 7,
      "datasource": {"type": "prometheus", "uid": "prometheus-bigdata"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [{"expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{consumergroup=~\"$group\",topic=~\"$topic\"})", "legendFormat": "컨슈머 {{consumergroup}} / 토픽 {{topic}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "파티션별 미처리 메시지 수",
      "description": "Kafka 파티션별로 컨슈머가 아직 처리하지 못한 메시지 수입니다. 특정 파티션에만 작업이 몰리는지 확인할 수 있습니다.",
      "id": 8,
      "datasource": {"type": "prometheus", "uid": "prometheus-bigdata"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [{"expr": "kafka_consumergroup_lag{consumergroup=~\"$group\",topic=~\"$topic\"}", "legendFormat": "{{consumergroup}} / {{topic}} / 파티션 {{partition}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "NLP 처리 흐름 (초당 건수)",
      "description": "원문 기사 유입, NLP 워커의 처리 완료 커밋, 분석 완료 기사 발행 속도를 비교합니다. NLP 워커를 직접 측정하지 않고 Kafka 오프셋으로 계산한 값입니다.",
      "id": 9,
