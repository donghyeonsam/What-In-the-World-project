# Docker 호스트에서 Kafka에 접속할 때 Kafka가 클라이언트에 알려줄 주소입니다.
# 로컬 개발은 localhost, 운영은 GPU/NLP 서버에서 접근 가능한 사설 IP/DNS를 사용합니다.
KAFKA_EXTERNAL_HOST=localhost

# Kafka 외부 포트를 열 네트워크 인터페이스입니다.
# 운영에서는 0.0.0.0 대신 허용된 사설 인터페이스 IP를 명시합니다.
KAFKA_BIND_HOST=127.0.0.1

# 중앙 Loki push API 주소입니다. Bigdata EC2에서 접근 가능한 사설 주소를 사용합니다.
LOKI_URL=http://10.0.0.10:3100/loki/api/v1/push
LOG_HOST=bigdata-prod

# 운영 Collector 대상입니다. legacy5는 기존 5개국, global47은
# registry_50country.csv에서 중국·이집트·노르웨이를 제외한 47개국입니다.
COLLECTOR_PROFILE=legacy5
# 비워두면 profile에 맞는 registry 파일을 Collector가 자동 선택합니다.
COLLECTOR_REGISTRY_PATH=

# Enriched Kafka -> HDFS silver writer. Compose 기본값을 바꿀 때 사용합니다.
SILVER_WRITER_GROUP_ID=news-enriched-hdfs-silver-v1
SILVER_HDFS_PATH=/data/news/silver/news.enriched.v1
# Silver HDFS 파일은 64 MiB, 50,000건, 5분 중 먼저 도달할 때 생성합니다.
SILVER_HDFS_BATCH_MAX_BYTES=67108864
SILVER_HDFS_BATCH_MAX_RECORDS=50000
SILVER_HDFS_BATCH_FLUSH_INTERVAL_SECONDS=300

# 신규 이슈 메타데이터 생성용 GMS(OpenAI 호환) 설정입니다.
GMS_API_KEY=
