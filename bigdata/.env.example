# Docker 호스트에서 Kafka에 접속할 때 Kafka가 클라이언트에 알려줄 주소입니다.
# 로컬 개발은 localhost, 운영은 GPU/NLP 서버에서 접근 가능한 사설 IP/DNS를 사용합니다.
KAFKA_EXTERNAL_HOST=localhost

# Kafka 외부 포트를 열 네트워크 인터페이스입니다.
# 운영에서는 0.0.0.0 대신 허용된 사설 인터페이스 IP를 명시합니다.
KAFKA_BIND_HOST=127.0.0.1

# Raw Kafka -> HDFS bronze writer. Compose 기본값을 바꿀 때 사용합니다.
BRONZE_WRITER_GROUP_ID=news-raw-hdfs-bronze-v1
BRONZE_HDFS_PATH=/data/news/bronze/news.raw.v1
